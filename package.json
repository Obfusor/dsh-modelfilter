{
  "name": "dsh-model-filter",
  "version": "0.2.1",
  "description": "Adds a filter box to DeepSeek Harness model pickers.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Obfusor/dsh-modelfilter.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "model-filter",
    "ai-models"
  ],
  "bugs": {
    "url": "https://github.com/Obfusor/dsh-modelfilter/issues"
  },
  "license": "MIT"
}
